void DibujarCorazon(uint16_t x, uint16_t y, uint16_t color)
{
    /* Parte superior */
    FillRect(x + 4,  y,      8,  5, color);
    FillRect(x + 18, y,      8,  5, color);

    FillRect(x,      y + 5,  30, 8, color);

    /* Parte media */
    FillRect(x + 3,  y + 13, 24, 7, color);

    /* Parte inferior */
    FillRect(x + 7,  y + 20, 16, 5, color);
    FillRect(x + 11, y + 25, 8,  4, color);
    FillRect(x + 14, y + 29, 3,  3, color);
}



void DibujarPulmones(uint16_t x, uint16_t y, uint16_t color)
{
    /* Traquea */
    FillRect(x + 14, y,      4, 10, color);

    /* Bronquios */
    FillRect(x + 10, y + 8,  4, 8, color);
    FillRect(x + 18, y + 8,  4, 8, color);

    /* Pulmon izquierdo */
    FillRect(x + 4,  y + 12, 8,  5, color);
    FillRect(x + 1,  y + 17, 11, 9, color);
    FillRect(x,      y + 26, 12, 6, color);

    /* Pulmon derecho */
    FillRect(x + 20, y + 12, 8,  5, color);
    FillRect(x + 20, y + 17, 11, 9, color);
    FillRect(x + 20, y + 26, 12, 6, color);
}


void MostrarEstado(uint16_t bpm, uint16_t spo2)
{
    char textoBPM[8];
    char textoSpO2[8];

    uint16_t fondoPanel;
    uint16_t fondoEstado;
    uint16_t colorEstado;
    uint16_t colorCorazon;
    uint16_t colorPulmon;


    if (bpm < 60)
    {
        /* BAJO */
        fondoPanel  = 0xFD20;   // naranja
        fondoEstado = 0xF800;   // rojo
        colorEstado = 0xFFFF;   // blanco

        colorCorazon = 0xF800;  // rojo
        colorPulmon  = 0x07FF;  // celeste
    }

    else if (bpm > 100)
    {
        /* ALTO */
        fondoPanel  = 0xF800;   // rojo
        fondoEstado = 0xF800;   // rojo
        colorEstado = 0xFFFF;   // blanco

        /* Corazon blanco para que resalte sobre rojo */
        colorCorazon = 0xFFFF;

        colorPulmon = 0x07FF;   // celeste
    }

    else
    {
        /* NORMAL */
        fondoPanel  = 0x2104;   // gris oscuro
        fondoEstado = 0x07E0;   // verde
        colorEstado = 0x0000;   // negro

        colorCorazon = 0xF800;  // rojo
        colorPulmon  = 0x07FF;  // celeste
    }


    FillRect(15, 55, 290, 120, fondoPanel);
    Rect(15, 55, 290, 120, 0xFFFF);


    DibujarCorazon(30, 67, colorCorazon);

    LCD_Print("FRECUENCIA CARDIACA",
              75, 63, 1,
              0xFFFF, fondoPanel);

    sprintf(textoBPM, "%u", bpm);

    LCD_Print(textoBPM,
              80, 85, 2,
              0xFFFF, fondoPanel);

    LCD_Print("BPM",
              175, 85, 2,
              0xFFFF, fondoPanel);


    DibujarPulmones(30, 122, colorPulmon);

    LCD_Print("OXIGENACION",
              75, 120, 1,
              0xFFFF, fondoPanel);

    sprintf(textoSpO2, "%u", spo2);

    LCD_Print(textoSpO2,
              90, 142, 2,
              0xFFFF, fondoPanel);

    LCD_Print("%",
              175, 142, 2,
              0xFFFF, fondoPanel);


    FillRect(15, 190, 290, 35, fondoEstado);

    if (bpm < 60)
    {
        LCD_Print("ESTADO: BAJO",
                  70, 200, 2,
                  colorEstado, fondoEstado);
    }

    else if (bpm > 100)
    {
        LCD_Print("ESTADO: ALTO",
                  70, 200, 2,
                  colorEstado, fondoEstado);
    }

    else
    {
        LCD_Print("ESTADO: NORMAL",
                  60, 200, 2,
                  colorEstado, fondoEstado);
    }
}


